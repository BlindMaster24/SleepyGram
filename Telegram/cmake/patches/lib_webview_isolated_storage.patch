+[[nodiscard]] bool HasStorageOverride() {
+	for (const auto name : {
+			"WEBVIEW2_USER_DATA_FOLDER",
+			"WEBVIEW2_BROWSER_EXECUTABLE_FOLDER",
+			"WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS",
+			"WEBVIEW2_PIPE_FOR_SCRIPT_DEBUGGER",
+			"WEBVIEW2_WAIT_FOR_SCRIPT_DEBUGGER" }) {
+		if (qEnvironmentVariableIsSet(name)) {
+			return true;
+		}
+	}
+	if (StrStrIW(GetCommandLineW(), L"edge-webview-switches")) {
+		return true;
+	}
+	for (const auto root : { HKEY_LOCAL_MACHINE, HKEY_CURRENT_USER }) {
+		for (const auto view : { KEY_WOW64_32KEY, KEY_WOW64_64KEY }) {
+			for (const auto policy : {
+					L"UserDataFolder",
+					L"BrowserExecutableFolder",
+					L"AdditionalBrowserArguments" }) {
+				const auto path = std::wstring(
+					L"Software\\Policies\\Microsoft\\Edge\\WebView2\\") + policy;
+				auto key = HKEY();
+				const auto status = RegOpenKeyExW(
+					root, path.c_str(), 0, KEY_QUERY_VALUE | view, &key);
+				if (status == ERROR_FILE_NOT_FOUND || status == ERROR_PATH_NOT_FOUND) {
+					continue;
+				} else if (status != ERROR_SUCCESS) {
+					return true;
+				}
+				auto values = DWORD();
+				const auto query = RegQueryInfoKeyW(
+					key, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr,
+					&values, nullptr, nullptr, nullptr, nullptr);
+				RegCloseKey(key);
+				if (query != ERROR_SUCCESS || values != 0) {
+					return true;
+				}
+			}
+		}
+	}
+	return false;
+}
+
+[[nodiscard]] bool MatchesUserDataFolder(
+		const winrt::com_ptr<ICoreWebView2Environment> &environment,
+		const std::wstring &expected,
+		HANDLE pinned) {
+	const auto version = environment.try_as<ICoreWebView2Environment7>();
+	auto effective = base::CoTaskMemString();
+	if (!version || version->get_UserDataFolder(effective.put()) != S_OK || !effective) {
+		return false;
+	}
+	const auto actual = QDir::toNativeSeparators(
+		QString::fromWCharArray(effective.data())).toStdWString();
+	if (CompareStringOrdinal(expected.c_str(), -1, actual.c_str(), -1, TRUE)
+		!= CSTR_EQUAL) {
+		return false;
+	}
+	const auto folder = PinDirectory(actual);
+	auto left = FILE_ID_INFO();
+	auto right = FILE_ID_INFO();
+	return folder
+		&& GetFileInformationByHandleEx(pinned, FileIdInfo, &left, sizeof(left))
+		&& GetFileInformationByHandleEx(folder.get(), FileIdInfo, &right, sizeof(right))
+		&& left.VolumeSerialNumber == right.VolumeSerialNumber
+		&& std::equal(std::begin(left.FileId.Identifier), std::end(left.FileId.Identifier),
+			std::begin(right.FileId.Identifier));
 }
 
